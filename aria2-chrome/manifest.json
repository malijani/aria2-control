{
  "manifest_version": 3,
  "name": "Aria2c Pro Controller",
  "version": "1.1",
  "description": "Control aria2c with download path updates and a master toggle.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:6800/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
